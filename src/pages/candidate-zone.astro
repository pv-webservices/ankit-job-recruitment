---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CandidateForm from '../components/CandidateForm.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/site';
---
<Layout title="Candidate Zone — Apply for Jobs" description="Register your details and apply for current openings with Ankit Jobs & Staffing India. 100% free recruitment — no registration fee.">
  <PageHero title="Your Next Step <em>Starts Here.</em>" crumb="Candidate Zone" eyebrow="Candidate zone" text="Fill in your personal, contact, education and location details to apply. 100% free — no registration fee, no hidden charges."/>
  <section class="section bg-ice">
    <div class="container register-wrap">
      <aside class="register-aside" data-reveal>
        <span class="eyebrow">Your career. Your possibilities.</span>
        <h2>A Few Details. <span class="text-blue">A New Beginning.</span></h2>
        <ul class="check-list">
          <li><Icon name="check" size={16}/>Keep your contact details accurate.</li>
          <li><Icon name="check" size={16}/>Outside India? Choose your country and type your city.</li>
          <li><Icon name="check" size={16}/>The alternative mobile number is optional.</li>
          <li><Icon name="check" size={16}/>Age is calculated automatically from your date of birth.</li>
        </ul>
        <div class="notice"><Icon name="lock" size={18}/><p><strong>Your details deserve care.</strong>Your application goes directly to the Ankit Jobs &amp; Staffing India team and is used only to process your job application. We never charge candidates a registration fee.</p></div>
        <div class="button-row" style="margin-top:18px"><a class="text-link" href="/privacy-policy/">Read the privacy notice <Icon name="arrow" size={16}/></a><a class="text-link" href={business.tel}>Need help? Call <span class="num">{business.phone}</span></a></div>
        <div class="register-photo"><div class="frame"><img src="/images/jobseeker.webp" alt="A young job seeker filling in details on her smartphone" width="800" height="1200" loading="lazy" decoding="async"/></div></div>
      </aside>
      <CandidateForm id="candidate-zone"/>
    </div>
  </section>
</Layout>
