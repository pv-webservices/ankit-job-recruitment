---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/Process.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="How It Works — Recruitment Journey" description="See the candidate journey at Ankit Jobs & Staffing India — from free online registration and profile review to interviews, selection and joining.">
  <PageHero title="One Step Closer to <em>What’s Next.</em>" crumb="How It Works" eyebrow="How it works" text="A simple outline of the recruitment journey, from registration to an employment opportunity."/>
  <section class="section">
    <div class="container process-wrap">
      <div class="process-intro" data-reveal>
        <span class="eyebrow">Five simple steps</span>
        <h2>From Registration to <span class="text-blue">Your Career</span></h2>
        <div class="notice" style="margin-top:22px"><Icon name="info" size={18}/><p>This outline is for guidance. Individual steps depend on available opportunities and each employer’s requirements.</p></div>
        <div class="button-row" style="margin-top:24px"><Button href="/candidate-zone/">Register Now</Button><a class="text-link" href="/contact-us/">Contact for assistance <Icon name="arrow" size={16}/></a></div>
        <div class="frame"><img src="/images/placement.webp" alt="A candidate discussing a possible career opportunity" width="960" height="640" loading="lazy" decoding="async"/></div>
      </div>
      <Process/>
    </div>
  </section>
</Layout>
