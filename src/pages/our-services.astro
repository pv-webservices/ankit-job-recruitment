---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import CareerCTA from '../components/CareerCTA.astro';
import { business, services } from '../data/site';
---
<Layout title="Our Services — Recruitment, Staffing & Training" description="Manpower recruitment, overseas placement, staffing services and corporate training from Ankit Jobs & Staffing India.">
  <PageHero title="Workforce Solutions <em>Built Around You.</em>" crumb="Our Services" eyebrow="Our services" text="From a single key hire to bulk manpower, overseas placement and team training — one trusted partner for your workforce needs." image="staffing" imageAlt="Representative staffing professionals at work">
    <div class="button-row stack-sm"><Button href="/recruiter-zone/">Share Your Requirement</Button><Button href={business.tel} variant="ghost-light" leadingIcon="phone" icon={false}>Call <span class="num">{business.phone}</span></Button></div>
  </PageHero>

  <section class="section bg-surface">
    <div class="container">
      <div class="section-head center" data-reveal><span class="eyebrow">What we offer</span><h2>Our Services</h2><p class="lead">Four ways we help businesses and candidates move forward.</p></div>
      <div class="grid-2 service-cards" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">
        {services.map((s, i) => (
          <article class="card lift" data-reveal style={`--delay:${i * 80}ms`}>
            <span class:list={['icon-badge', { navy: i % 2 === 1 }]}><Icon name={s.icon} size={26}/></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a class="text-link" href={`#${s.slug}`}>Learn more <Icon name="arrow" size={16}/></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {services.map((s, i) => (
        <div class="service-row" id={s.slug}>
          <div class="service-media" data-reveal>
            <div class="frame"><img src={`/images/${s.image}.webp`} alt={`Representative image for ${s.title}`} width="960" height="640" loading="lazy" decoding="async"/></div>
            <span class="service-index num">0{i + 1}</span>
          </div>
          <div class="service-copy" data-reveal style="--delay:90ms">
            <span class="eyebrow">Service 0{i + 1}</span>
            <h2>{s.title}</h2>
            <p class="lead">{s.text}</p>
            <ul class="check-list">{s.points.map((p) => <li><Icon name="check" size={16}/>{p}</li>)}</ul>
            <div class="button-row"><Button href="/recruiter-zone/">Enquire Now</Button><a class="text-link" href={business.tel}>Call <span class="num">{business.phone}</span></a></div>
          </div>
        </div>
      ))}
    </div>
  </section>
  <CareerCTA/>
</Layout>
