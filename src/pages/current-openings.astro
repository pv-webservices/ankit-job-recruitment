---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CareerCTA from '../components/CareerCTA.astro';
import JobOpenings from '../components/JobOpenings.astro';
import { business, careerSupport } from '../data/site';
import { jobs } from '../data/jobs';
const jobsCount = jobs.length;
---
<Layout title="Current Openings" description="Current job openings for freshers in manufacturing and private banking — direct payroll, pan-India postings. Apply free with Ankit Jobs & Staffing India.">
  <PageHero title="Your Next Job <em>Starts Here.</em>" crumb="Current Openings" eyebrow="Current openings" text="Urgent openings for freshers in manufacturing and private banking. Direct payroll, pan-India postings — and 100% free to apply." image="placement" imageAlt="A candidate discussing a role with a recruiter">
    <div class="button-row stack-sm"><Button href="#openings-title">See Openings</Button><Button href={business.whatsapp} external variant="whatsapp" leadingIcon="whatsapp" icon={false}>Enquire About Jobs</Button></div>
  </PageHero>

  <section class="section" aria-labelledby="openings-title">
    <div class="container">
      <div class="section-head split" data-reveal>
        <div>
          <span class="eyebrow">Hiring now</span>
          <h2 id="openings-title">Current Job Openings</h2>
          <p class="lead">Tap a poster to see full details, then apply in a minute. 100% free — no registration fee, no hidden charges.</p>
        </div>
        <span class="status-pill">{jobsCount} openings live</span>
      </div>
      <JobOpenings/>
      <p class="lead" style="margin-top:28px;text-align:center">Don’t see the right role? <a href="/candidate-zone/">Register your details</a> and we’ll contact you when a suitable job opens up.</p>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container split">
      <div class="split-media" data-reveal>
        <div class="frame"><img src="/images/jobseeker.webp" alt="A young job seeker checking opportunities on her phone" width="800" height="1200" loading="lazy" decoding="async" style="object-position:50% 22%"/></div>
        <span class="frame-tag"><Icon name="sparkle" size={16}/>Your Career, Our Mission</span>
      </div>
      <div class="split-copy" data-reveal>
        <span class="eyebrow">Career placement</span>
        <h2>Connecting job seekers with the right opportunities.</h2>
        <p>Every career move starts with a conversation. Tell us about your education, experience and the kind of work you are looking for, and understand the next steps before you apply.</p>
        <ul class="check-list">{careerSupport.map((p) => <li><Icon name="check" size={16}/>{p}</li>)}</ul>
        <div class="button-row" style="margin-top:24px"><Button href="/candidate-zone/">Apply Now</Button><a class="text-link" href="/how-it-works/">How it works <Icon name="arrow" size={16}/></a></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq-page">
      <SectionTitle eyebrow="A little more clarity" title="Before Your Next Step" text="Useful information for your career enquiry."/>
      <FAQ limit={4}/>
    </div>
  </section>
  <CareerCTA/>
</Layout>
