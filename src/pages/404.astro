---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---
<Layout title="Page Not Found" description="This page could not be found. Return to Ankit Jobs & Staffing India or contact the team for recruitment and staffing enquiries." noindex>
  <section class="section error-page pattern-dots">
    <div class="container-narrow">
      <span class="error-number num" aria-hidden="true">404</span>
      <h1>Let’s Get You Back on Track.</h1>
      <p class="lead">The page you are looking for may have moved or is no longer available. There’s still a next step.</p>
      <div class="button-row stack-sm"><Button href="/">Back to Home</Button><Button href="/contact-us/" variant="outline">Contact Us</Button></div>
    </div>
  </section>
</Layout>
