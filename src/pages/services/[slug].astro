---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { services, business } from '../../data/site';
export function getStaticPaths() { return services.map((service) => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
const candidate = service.slug === 'career-placement';
---
<Layout title={service.title} description={`${service.description} Enquire with Ankit Jobs & Staffing India about ${service.title.toLowerCase()} in Kolkata, Vizag and Odisha.`}>
  <PageHero title={service.title} eyebrow={service.audience} text={service.description} image={service.image} imageAlt={service.alt}>
    <div class="button-row stack-sm">
      {candidate
        ? <Button href="/candidate-registration/">{service.cta}</Button>
        : <Button href={business.employerWhatsapp} external variant="whatsapp" leadingIcon="whatsapp" icon={false}>{service.cta}</Button>}
      <Button href={business.tel} variant="ghost-light" leadingIcon="phone" icon={false}>Call Now</Button>
    </div>
  </PageHero>
  <section class="section">
    <div class="container detail-grid">
      <div data-reveal>
        <span class="eyebrow">A good place to begin</span>
        <h2>{service.intro}</h2>
        <p class="lead" style="margin-top:16px">{service.body}</p>
        <ul class="check-list">{service.points.map((point) => <li><Icon name="check" size={16}/>{point}</li>)}</ul>
        <div class="notice"><Icon name="info" size={18}/><p>Service descriptions are an overview for discussion. Confirm availability, process and any applicable terms directly with the team.</p></div>
      </div>
      <aside class="detail-aside on-dark" data-reveal style="--delay:90ms">
        <span class="icon-badge"><Icon name={service.icon} size={26}/></span>
        <h3>Let’s discuss your next step.</h3>
        <p>{candidate ? 'Enquire about current opportunities, qualifications and registration.' : 'Share a general outline of your hiring requirement. Please do not send candidate or family details through WhatsApp.'}</p>
        <div class="chip-row on-dark" style="margin-top:14px">{['Kolkata', 'Vizag', 'Odisha'].map((place) => <span class="chip"><Icon name="pin" size={14}/>{place}</span>)}</div>
        <Button href={business.tel} leadingIcon="phone" icon={false}>Call <span class="num">{business.phone}</span></Button>
        <Button href="/contact-us/" variant="ghost-light">More ways to connect</Button>
      </aside>
    </div>
  </section>
  <section class="section bg-surface pattern-dots">
    <div class="container">
      <SectionTitle eyebrow="Explore more" title="Explore Our Services" text="Support for different stages of the hiring conversation."/>
      <ServiceCards/>
    </div>
  </section>
</Layout>
