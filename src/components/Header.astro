---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { navigation, business } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href;
---
<a class="skip-link" href="#main">Skip to content</a>
<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-group">
      <span><Icon name="pin" size={15}/> Kolkata · Vizag · Odisha</span>
      <a href={business.tel}><Icon name="phone" size={14}/><span class="num">{business.phone}</span></a>
      <a href={`mailto:${business.email}`}><Icon name="mail" size={14}/>{business.email}</a>
    </div>
    <em>Your Career, Our Mission</em>
  </div>
</div>
<header class="site-header" id="site-header">
  <div class="container header-inner">
    <Brand/>
    <div class="header-actions">
      <a class="header-callbox" href={business.tel} aria-label={`Call ${business.phone}`}>
        <span class="callbox-ico"><Icon name="phone" size={18}/></span>
        <span><small>Call us now</small><strong class="num">{business.phone}</strong></span>
      </a>
      <Button href="/candidate-zone/" size="sm">Register Now</Button>
    </div>
    <div class="header-mobile-actions">
      <a class="social-btn call" href={business.tel} aria-label={`Call ${business.phone}`}><Icon name="phone" size={19}/></a>
      <button class="menu-toggle" type="button" aria-controls="site-drawer" aria-expanded="false" aria-label="Open menu"><Icon name="menu" size={24}/></button>
    </div>
  </div>
  <div class="nav-bar">
    <div class="container">
      <nav class="main-nav" id="main-navigation" aria-label="Main navigation">
        {navigation.map(([label, href]) => <a href={href} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </div>
</header>
<!-- The drawer sits outside the sticky header so its fixed position is always viewport-relative. -->
<div class="drawer" id="site-drawer" role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="drawer-head">
    <Brand drawer/>
    <button class="drawer-close" type="button" aria-label="Close menu"><Icon name="cross" size={22}/></button>
  </div>
  <nav class="drawer-nav" aria-label="Mobile navigation">
    {navigation.map(([label, href]) => <a href={href} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? 'page' : undefined}>{label}<Icon name="chevron" size={18}/></a>)}
    <a href="/faq/" class:list={{ active: path === '/faq/' }}>FAQs<Icon name="chevron" size={18}/></a>
  </nav>
  <div class="drawer-cta">
    <Button href="/candidate-zone/" block>Register as a Candidate</Button>
    <Button href={business.tel} variant="ghost-light" leadingIcon="phone" icon={false} block>Call <span class="num">{business.phone}</span></Button>
  </div>
  <div class="drawer-contact">
    <a href={`mailto:${business.email}`}><Icon name="mail" size={18}/>{business.email}</a>
    <span><Icon name="pin" size={18}/>Kolkata · Vizag · Odisha</span>
  </div>
</div>
<div class="drawer-backdrop" data-drawer-close></div>
