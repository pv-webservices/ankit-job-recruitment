---
import { faqs } from '../data/site';
interface Props { limit?: number; }
const { limit = faqs.length } = Astro.props;
---
<div class="faq-list">
  {faqs.slice(0, limit).map((item, i) => (
    <details data-reveal style={`--delay:${i * 60}ms`} open={i === 0}>
      <summary>{item.q}<span class="faq-toggle" aria-hidden="true"></span></summary>
      <div class="faq-answer"><p>{item.a}</p></div>
    </details>
  ))}
</div>
