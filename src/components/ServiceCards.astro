---
import Icon from './Icon.astro';
import { services } from '../data/site';
---
<div class="bento rail">
  {services.map((s, i) => (
    <a href={`/services/${s.slug}/`} class="service-tile" data-reveal style={`--delay:${i * 80}ms`}>
      <img src={`/images/${s.image}.webp`} alt={s.alt} width="960" height="640" loading="lazy" decoding="async"/>
      <span class="tile-meta">{s.audience}</span>
      <span class="icon-badge"><Icon name={s.icon} size={26}/></span>
      <h3>{s.title}</h3>
      <p>{s.description}</p>
      <span class="tile-cta">Explore service <Icon name="arrow" size={18}/></span>
    </a>
  ))}
</div>
<span class="rail-hint">Swipe to explore <Icon name="arrow" size={16}/></span>
