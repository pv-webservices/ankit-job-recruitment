---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { business, navigation } from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-cta">
    <h2>Your next opportunity starts here — <span>let’s talk.</span></h2>
    <div class="button-row">
      <Button href="/candidate-registration/">Register Now</Button>
      <Button href={business.whatsapp} external variant="whatsapp" leadingIcon="whatsapp" icon={false}>WhatsApp Us</Button>
    </div>
  </div>
  <div class="container footer-grid">
    <div class="footer-brand">
      <Brand footer/>
      <p>Recruitment and job placement support for job seekers.</p>
      <div class="chip-row on-dark">{['Kolkata', 'Vizag', 'Odisha'].map(place => <span class="chip"><Icon name="pin" size={15}/>{place}</span>)}</div>
      <em>Your Career… Our Mission</em>
    </div>
    <div>
      <h2>Quick Links</h2>
      <ul class="footer-links">{navigation.map(([label, href]) => <li><a href={href}><Icon name="chevron" size={14}/>{label}</a></li>)}<li><a href="/faq/"><Icon name="chevron" size={14}/>FAQs</a></li></ul>
    </div>
    <div>
      <h2>For Candidates</h2>
      <ul class="footer-links"><li><a href="/career/"><Icon name="chevron" size={14}/>Career</a></li><li><a href="/candidate-registration/"><Icon name="chevron" size={14}/>Candidate Registration</a></li><li><a href="/how-it-works/"><Icon name="chevron" size={14}/>How It Works</a></li></ul>
    </div>
    <div class="footer-contact-col">
      <h2>Contact Information</h2>
      <div class="footer-contact">
        <span><span class="contact-ico"><Icon name="user" size={18}/></span>Contact person: Ankit Rai</span>
        <a href={business.tel}><span class="contact-ico"><Icon name="phone" size={18}/></span><span class="num">{business.phone}</span></a>
        <a href={`mailto:${business.email}`}><span class="contact-ico"><Icon name="mail" size={18}/></span>{business.email}</a>
        <a href={business.whatsapp} target="_blank" rel="noopener noreferrer"><span class="contact-ico"><Icon name="whatsapp" size={19}/></span>WhatsApp enquiry</a>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© <span class="num" data-year>{new Date().getFullYear()}</span> Ankit Jobs &amp; Staffing India. All rights reserved.</span>
    <nav aria-label="Legal"><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-and-conditions/">Terms &amp; Conditions</a><a href="/disclaimer/">Disclaimer</a></nav>
  </div>
  <p class="footer-disclaimer container">Opportunities depend on availability and employer selection. Registration does not guarantee employment. Images are representative.</p>
</footer>
<a class="whatsapp-float" href={business.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp"><Icon name="whatsapp" size={30}/><span>Chat with us</span></a>
<div class="mobile-bar" aria-label="Quick actions">
  <Button href={business.tel} variant="outline" leadingIcon="phone" icon={false}>Call</Button>
  <Button href="/candidate-registration/">Register Now</Button>
</div>
