# Set the approved public HTTPS origin before building a release.
PUBLIC_SITE_URL=
# Form submission is intentionally unavailable. See docs/FORM-INTEGRATION.md.

# Server-side only — used by scripts/images/generate.mjs. Never expose to the browser.
OPENAI_API_KEY=
# Optional overrides (defaults live in scripts/images/config.mjs)
OPENAI_IMAGE_MODEL_FLARE=gpt-image-2.5-flare
OPENAI_IMAGE_MODEL_SUNBURST=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY_DEFAULT=medium
OPENAI_IMAGE_QUALITY_PREMIUM=high
