{
  "name": "ankit-jobs-staffing-india",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/security-headers.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "astro check",
    "audit:site": "node scripts/audit-build.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "test:cross-browser": "node scripts/cross-browser-qa.mjs",
    "test:seo": "node scripts/check-seo.mjs",
    "images:generate": "node --env-file=.env scripts/images/generate.mjs",
    "images:optimize": "node scripts/images/generate.mjs --optimize-only"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "lighthouse": "13.6.0",
    "playwright": "1.65.0",
    "typescript": "6.0.3"
  }
}
